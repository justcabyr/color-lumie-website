---
const path = Astro.url.pathname;
const onHome = path === '/' || path === '';
const onPrivacy = path === '/privacy' || path.startsWith('/privacy');
const onTerms = path === '/terms' || path.startsWith('/terms');

const link = (active: boolean) =>
  [active && 'text-orange-600', 'hover:underline'].filter(Boolean).join(' ');

const brandClass = ['text-lg font-medium', onHome && 'text-orange-600']
  .filter(Boolean)
  .join(' ');
---

<header class="mb-10">
  <div class="flex items-center justify-between">
    <a href="/" class={brandClass}>
      <span>Color Lumie</span>
    </a>

    <nav class="space-x-6 text-sm">
      <a href="/privacy" class={link(onPrivacy)}>Privacy</a>
      <a href="/terms" class={link(onTerms)}>Terms</a>
    </nav>
  </div>
  <hr class="mt-6 border-0 border-t border-gray-200" />
</header>
