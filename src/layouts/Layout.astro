---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  bodyClass?: string;
  title?: string;
}

const { bodyClass, title = 'Color Lumie' } = Astro.props;
const bodyDefault = 'bg-[#f9f7f1] text-[#1a1a1a]';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={['font-sans', bodyClass ?? bodyDefault]}>
    <main class="max-w-3xl mx-auto px-6 py-10">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
  }
</style>
<ClientRouter />
